DISCORD_TOKEN=replace_with_new_bot_token
# Optional: for instant slash command sync in a test server
TEST_GUILD_ID=
# Enable only after enabling Server Members Intent in Discord Developer Portal
ENABLE_MEMBER_EVENTS=false
# Only enable after enabling Message Content Intent in Developer Portal
ENABLE_MESSAGE_CONTENT=false
# auto: test guild when configured, otherwise global; test/global/off are explicit
COMMAND_SYNC_SCOPE=auto
# Enable AI replies only when Message Content Intent is enabled in Developer Portal
AI_ENABLED=false
# Local Ollama settings (AI chat integration is opt-in and not loaded yet)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_NORMAL=qwen3.5:4b
OLLAMA_MODEL_GAMING=qwen3.5:4b
LLM_THINKING_ENABLED=false
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=256
LLM_KEEP_ALIVE=5m
LLM_MAX_CONCURRENT=1
LLM_TIMEOUT_SECONDS=30
